# Neon PostgreSQL pooled connection string
DATABASE_URL=

# Admin account. Generate a bcrypt hash; never put the plain password here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Telegram Bot API. Keep both values server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS deployment URL used by Telegram Mini Apps
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
NEXT_PUBLIC_TELEGRAM_USERNAME=your_telegram_contact_username
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Code_Craft_Studio_Bot
