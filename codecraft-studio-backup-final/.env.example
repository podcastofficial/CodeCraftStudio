# Database: Neon PostgreSQL pooled connection string
DATABASE_URL=

# Admin account. Generate a bcrypt hash; never put the plain password here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Telegram Bot API. Keep both values server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_USERNAME=your_telegram_username
